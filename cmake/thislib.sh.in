#!/bin/bash
#
# thislib.@LIBRARY@.sh — put an installed lib@LIBRARY@ on the environment.
#
#     source <prefix>/bin/thislib.@LIBRARY@.sh
#     c++ demo.cc -lKalmanFramework -o demo && ./demo
#
# There is nothing ROOT-specific here: lib@LIBRARY@ is a plain shared library, so
# this only needs to make the loader and the compiler able to find it.
# Generated by CMake from cmake/thislib.sh.in.

# BASH_SOURCE[0] is the script itself whether it is sourced interactively or
# from `bash -c 'source ...'`; $0 is only right when the script is executed.
if [[ -n "${BASH_SOURCE[0]}" ]]; then REALFILE="${BASH_SOURCE[0]}"; else REALFILE="$0"; fi
REALPATH="$(cd "$(dirname "$REALFILE")" && pwd)"
PREFIX="$(cd "$REALPATH/.." && pwd)"
LIBDIR="$PREFIX/lib"
INCDIR="$PREFIX/include"

# ── PATH (the example binaries) ──────────────────────────────────────────────
case ":$PATH:" in
    *":$REALPATH:"*) ;;
    *) export PATH="$REALPATH:$PATH" ;;
esac

# ── Loader path ──────────────────────────────────────────────────────────────
if [[ "$(uname)" == "Darwin" ]]; then
    case ":$DYLD_LIBRARY_PATH:" in
        *":$LIBDIR:"*) ;;
        *) export DYLD_LIBRARY_PATH="$LIBDIR${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" ;;
    esac
else
    case ":$LD_LIBRARY_PATH:" in
        *":$LIBDIR:"*) ;;
        *) export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
fi

# ── Headers, for compiling against it ────────────────────────────────────────
case ":$CPLUS_INCLUDE_PATH:" in
    *":$INCDIR:"*) ;;
    *) export CPLUS_INCLUDE_PATH="$INCDIR${CPLUS_INCLUDE_PATH:+:$CPLUS_INCLUDE_PATH}" ;;
esac

# ── pkg-config, if a consumer prefers that route ─────────────────────────────
if [[ -d "$LIBDIR/pkgconfig" ]]; then
    case ":$PKG_CONFIG_PATH:" in
        *":$LIBDIR/pkgconfig:"*) ;;
        *) export PKG_CONFIG_PATH="$LIBDIR/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" ;;
    esac
fi

# ── ROOT_INCLUDE_PATH: only relevant when a ROOT consumer wants the headers ──
# visible to Cling (e.g. `.L analysis.C+`). Harmless when ROOT is absent.
case ":$ROOT_INCLUDE_PATH:" in
    *":$INCDIR:"*) ;;
    *) export ROOT_INCLUDE_PATH="$INCDIR${ROOT_INCLUDE_PATH:+:$ROOT_INCLUDE_PATH}" ;;
esac

unset REALFILE REALPATH PREFIX LIBDIR INCDIR
