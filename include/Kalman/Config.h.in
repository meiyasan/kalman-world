/**
 * *********************************************
 *
 * \file Config.h.in
 * \brief Build-time configuration of libKalman
 * \author Marco Meyer \<marco.meyer@omu.ac.jp\>
 *
 * *********************************************
 *
 * \details Configured by CMake into `Kalman/Config.h`.
 *
 * libKalman has **no required dependency**. The flag below only selects a
 * faster implementation of something that already works.
 *
 * *********************************************
 */

#ifndef KALMAN_CONFIG_H_IN
#define KALMAN_CONFIG_H_IN

#define KALMAN_VERSION       "@KALMAN_VERSION@"
#define KALMAN_VERSION_MAJOR @KALMAN_VERSION_MAJOR@
#define KALMAN_VERSION_MINOR @KALMAN_VERSION_MINOR@

/**
 * A CBLAS implementation (Accelerate, OpenBLAS, MKL) is linked, and matrix
 * products at or above KALMAN_BLAS_MIN_DIM go through `cblas_dgemm`.
 *
 * Below that threshold the hand-rolled kernel is measurably faster — a BLAS call
 * costs ~20 ns of argument handling, which is more than a 4x4 product — so the
 * backend is chosen per operation, not once for the whole library.
 */
#cmakedefine01 KALMAN_WITH_BLAS

/// zlib is linked: the tables of model files are compressed, and compressed ones are read.
#cmakedefine01 KALMAN_WITH_ZLIB

/// Size at or above which matrix products are handed to BLAS. Measured, not guessed.
#define KALMAN_BLAS_MIN_DIM @KALMAN_BLAS_MIN_DIM@

// The AI runtimes (libTorch, ONNX Runtime) belong to libKalmanLearn: see
// Kalman/Learn/Learn.h. libKalman never links them.

#endif // KALMAN_CONFIG_H_IN
